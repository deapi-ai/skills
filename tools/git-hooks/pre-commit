#!/bin/sh
# Blocks commits that would publish keys, private hosts, task numbers or local
# paths. Enable once per clone:  git config core.hooksPath tools/git-hooks
PY=python3
command -v "$PY" >/dev/null 2>&1 || PY=python
"$PY" tools/scan_leaks.py --staged || {
  echo "pre-commit: scan_leaks found something that must not be published." >&2
  exit 1
}
